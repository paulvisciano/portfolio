{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": ["paulvisciano.vercel.app"],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "https://pub-9466bb5132e74aeba333004ad0c21f21.r2.dev/portfolio/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
